{
  "name": "mo-receiving-labels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.33",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "wait-on": "^8.0.1"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix server",
    "predev": "npx --yes kill-port 3010 3011",
    "dev": "concurrently -k -n backend,frontend -c magenta,cyan \"npm --prefix server run dev\" \"wait-on tcp:127.0.0.1:3011 && vite\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix server run dev",
    "build": "vite build",
    "build:iis": "vite build && copy web.config dist\\web.config"
  }
}
