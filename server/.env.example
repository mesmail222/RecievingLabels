DATABASE_SERVER=your-sql-server-hostname
DATABASE_NAME=ScheduleDB
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_ENCRYPT=false
DATABASE_TRUST_CERT=true
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_POOL_IDLE_TIMEOUT=30000
PORT=3011
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:8087,http://shock:8087

# Exact URL generated by the Receiving workstation's BarTender Web Service Integration.
BARTENDER_INTEGRATION_URL=http://RECEIVING-STATION:38178/ReceivingLabels

# These values are resolved on the Receiving workstation.
BARTENDER_TEMPLATE_PATH=C:\BarTender\RecievingFormat.btw
BARTENDER_PRINTER_NAME=Exact Windows printer name

# Set both only when the BarTender integration uses Basic authentication.
BARTENDER_USERNAME=
BARTENDER_PASSWORD=
BARTENDER_TIMEOUT_MS=120000
