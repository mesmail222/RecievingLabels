# Required — server will fail to start without these
DATABASE_SERVER=your-sql-server-hostname
DATABASE_NAME=ScheduleDB
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password

# Optional
DATABASE_ENCRYPT=false
DATABASE_TRUST_CERT=true
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_POOL_IDLE_TIMEOUT=30000
PORT=3011
ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:8084
